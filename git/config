[include]
  path = user
[init]
  defaultBranch = main
[pull]
  rebase = true
[fetch]
  recurseSubmodules = true
  parallel = 0
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[diff]
  external = difft
[commit]
  template = ~/config/git/commit-template.txt
