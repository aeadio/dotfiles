#!/bin/sh

# Run the provided command at lowest CPU and I/O priority class, and maximal
# niceness.

re_mode=
if [ "$1" = "-p" ]; then
  re_mode=1
  shift
fi

if [ -n "$re_mode" ]; then
  for pid in "$@"; do
    ionice -c 3 -p "$pid"
  done
  schedtool -n 19 -D "$@"
else
  exec ionice -c 3 schedtool -n 19 -D -e "$@"
fi
