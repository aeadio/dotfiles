#!/bin/sh

picom_conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/picom"
if [ -w "$picom_conf_dir" ]; then
  cat <<EOF > "$picom_conf_dir/dynamic-blur.conf"
# Transparency
active-opacity   = 1.00
inactive-opacity = 0.90

# Blur
blur-background         = true
blur-background-frame   = true
blur-background-fixed   = true
blur-method             = "dual_kawase"
blur-strength           = 15
EOF
fi
