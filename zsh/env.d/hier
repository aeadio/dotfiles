# vim: ft=sh ts=2 sw=2 et:

# Informs apps as to the directory hierarchy of ~

# Language-specific tooling
() {
  local gopath=(
    $HOME/[Ss]ource/go(N)
    $HOME/src/go(N)
  )
  typeset -gx GOPATH=${(j,:,)gopath}
}

# Shell configuration
typeset -g path=(
  # Scripts and personal projects
  $HOME/[Pp]rojects/*/[Bb]in(N)
  $HOME/[Bb]in(N)
  ${~${GOPATH:+${(@s,:,)GOPATH}}/%//bin}(N)  # expand multiple gopath entries correctly, with /bin appended to each
  
  # System-wide, manually managed
  /opt/bin(N)
  /opt/*/bin(N)
  
  # System-wide, owned by system package manager
  /usr/local/(|s)bin(N)
  /usr/(|s)bin(N)
  /(|s)bin(N)
  $path
)
typeset -g path=( ${(u)path} )  # (u) removes dups inherited from default $path

# XDG desktop specification
typeset -gx XDG_CONFIG_HOME=${XDG_CONFIG_HOME:=${ZSH:h}}
typeset -gx XDG_DATA_HOME=$HOME/var
typeset -gx XDG_CACHE_HOME=$HOME/var/cache
typeset -gx XDG_STATE_HOME=$HOME/var/state

() {
  local xdg_data_dirs=(
    $HOME/var/flatpak/exports/share(N)
    /var/lib/flatpak/exports/share(N)
    /usr/local/share(N)
    /usr/share(N)
  )
  typeset -gx XDG_DATA_DIRS=${(j,:,)xdg_data_dirs}
}

# Application level paths
typeset -gx WINEPREFIX=$XDG_DATA_HOME/wine
typeset -gx XBPS_DISTDIR=$HOME/source/void-packages
