[Desktop Entry]
Name=1Password
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=1password --file-forwarding com.onepassword.OnePassword --disable-smooth-scrolling @@u %U @@
Terminal=false
Type=Application
Icon=com.onepassword.OnePassword
StartupWMClass=1Password
Comment=Password manager and secure wallet
MimeType=x-scheme-handler/onepassword;
Categories=Office;
X-Flatpak-RenamedFrom=1password.desktop;
X-Flatpak=com.onepassword.OnePassword
