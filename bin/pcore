#!/bin/sh

# Run the program on the system's performance, efficiency, or low-power
# efficiency cores.

pcore_mask=0xFFFFFFFF
ecore_mask=0xFFFFFFFF
lcore_mask=0xFFFFFFFF

re_mode=
if [ "$1" = "-p" ]; then
  re_mode=1
  shift
fi

warn() {
  printf '%s\n' "$1" >&2
}

case "$(lscpu | sed -n 's/.*Model name:[[:space:]]*\(.*\)[[:space:]]*/\1/p')" in
  *'Ultra 7 165H'*)
    case "$(nproc)" in
      22)  # SMT enabled
        pcore_mask=0x000FFF
        ecore_mask=0x3FF000
        lcore_mask=0x300000
        ;;
      16)  # SMT disabled
        pcore_mask=0x00003F
        ecore_mask=0x00FFC0
        lcore_mask=0x00C000
        ;;
      *)   # unknown configuration; fail open w/ all CPUs
        warn "unknown core configuration, running on all CPUs"
        ;;
    esac
    ;;
esac

case "$(basename "$0")" in
  pcore) mask=$pcore_mask ;;
  ecore) mask=$ecore_mask ;;
  lcore) mask=$lcore_mask ;;
  *)
    warn "unknown binary name $0, running on all CPUs"
    mask=0xFFFFFFFF
    ;;
esac

if [ -n "$re_mode" ]; then
  for pid in "$@"; do
    taskset -p $mask "$pid"
  done
else
  printf '%s\n' "Starting up with process mask $mask..." >&2
  exec taskset $mask "$@"
fi
