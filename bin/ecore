#!/bin/sh

# Run the program on the system's P cores

pcore_mask=0xFFFFFFFF
ecore_mask=0xFFFFFFFF

case "$(lscpu | sed -n 's/Model name:[[:space:]]*\(.*\)[[:space:]]*@.*/\1/p')" in
  'Core Ultra 7 165H')
    case "$(nproc)" in
      22)  # SMT enabled
        pcore_mask=0x000FFF
        ecore_mask=0x3FF000
        ;;
      16)  # SMT disabled
        pcore_mask=0x00003F
        ecore_mask=0x00FFC0
        ;;
      *)   # unknown configuration; fail open w/ all CPUs
        ;;
    esac
    ;;
esac

exec taskset $ecore_mask "$@"
