#!/usr/bin/env python

import os, sys, gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio

def get_xdg_data_dirs():
  xdg_data_home = os.getenv("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
  xdg_data_dirs = os.getenv("XDG_DATA_DIRS", "/usr/local/share/:/usr/share/").split(":")
  return [xdg_data_home] + xdg_data_dirs

def get_desktop_files():
  desktop_files = {}
  
  for directory in get_xdg_data_dirs():
    application_folder = os.path.join(directory, "applications")
    if os.path.exists(application_folder):
      for root, dirs, files in os.walk(application_folder):
        for file in files:
          if file.endswith(".desktop"):
            file_path = os.path.join(root, file)
            if file not in desktop_files:
              try:
                desktop_file = Gio.DesktopAppInfo.new_from_filename(file_path)
                desktop_files[file] = {'name': desktop_file.get_name(), 'path': file_path, 'hidden': desktop_file.get_is_hidden()}
              except Exception as e:
                print(f"Error reading {file_path}: {e}", file=sys.stderr)
  
  return desktop_files

# Print the list of .desktop files with their names and paths
desktop_files = get_desktop_files()
for filename, info in desktop_files.items():
  if not info['hidden']:
    print(f"{info['path']} {info['name']}")
