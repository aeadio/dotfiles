#!/bin/sh

status_ac=0

change_ac() {
  #nvidia-settings -a "[gpu:0]/GpuPowerMizerMode=1"
  #doas cpupower frequency-set -g performance
  LC_COLLATE=C
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/pmd/ac/*; do
    [ -x "$f" ] && "$f"
  done
}

change_bat() {
  #nvidia-settings -a "[gpu:0]/GpuPowerMizerMode=0"
  #doas cpupower frequency-set -g powersave
  LC_COLLATE=C
  wfor f in "${XDG_CONFIG_HOME:-$HOME/.config}"/pmd/battery/*; do
    [ -x "$f" ] && "$f"
  done
}

ac_changed() {
  if [ "$(cat "sys/class/power_supply/AC/online")" = "1" ]; then
    if [ "$status_ac" -ne 1 ]; then
      change_ac
      status_ac=1
    fi
  else
    if [ "$status_ac" -eq 1 ]; then
      change_bat
      status_ac=0
    fi
  fi
}

ac_changed

stdbuf -o 0 udevadm monitor -s power_supply -u |
  while read _; do
    ac_changed
  done
