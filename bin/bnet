#!/bin/sh

export PBA_DISABLE=1
export WINEESYNC=1
export STAGING_SHARED_MEMORY=1
export __GL_DXVK_OPTIMIZATIONS=1
export __GL_SHADER_DISK_CACHE=1
export DXVK_ENABLE_NVAPI=1
export DXVK_CONFIG="dxgi.deferSurfaceCreation = True; dxgi.hideNvidiaGpu = False"

case "$(basename "$0")" in
  bnet)
    cd "$HOME/games/Battle.net" &&
    exec pcore prime-run wine Battle.net.exe
    ;;
  wow-vanilla)
    cd "$HOME/games/World of Warcraft/_classic_era_" &&
    exec pcore prime-run wine WowClassic.exe
    ;;
esac
